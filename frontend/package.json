{
  "name": "hackalem-ekt-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "sync:assistant": "node scripts/sync-assistant.mjs",
    "predev": "npm run sync:assistant",
    "dev": "next dev --webpack -p 3000",
    "prebuild": "npm run sync:assistant",
    "build": "next build --webpack",
    "start": "next start -p 3000",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "pretype-check": "npm run sync:assistant",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:landing": "playwright test -c playwright.landing.config.ts",
    "test:landing:live": "EKT_LIVE_TEST=1 playwright test -c playwright.landing.config.ts",
    "test:next": "playwright test -c playwright.next.config.ts",
    "test:next:live": "EKT_LIVE_TEST=1 playwright test -c playwright.next.config.ts"
  },
  "dependencies": {
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@radix-ui/react-slot": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2"
  }
}
